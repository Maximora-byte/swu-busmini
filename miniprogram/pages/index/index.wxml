<view class="page {{routeDetailsExpanded ? 'page--route-expanded' : ''}}">
  <view class="location-panel location-panel--{{locationStatusKind}}">
    <view class="location-panel__content">
      <view class="location-panel__dot"></view>
      <text class="location-panel__text">{{locationStatusText}}</text>
    </view>
    <view class="location-panel__actions">
      <button
        wx:if="{{canOpenSettings}}"
        class="location-panel__button"
        size="mini"
        open-type="openSetting"
        bindopensetting="handleOpenSetting"
      >去设置</button>
      <button
        wx:elif="{{locationStatusKind === 'error'}}"
        class="location-panel__button"
        size="mini"
        bindtap="handleRetry"
      >重试</button>
    </view>
  </view>
  <map
    class="campus-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{busStopMarkers}}"
    show-location="{{hasLocation}}"
    show-scale
  ></map>
  <view class="route-panel {{routeDetailsExpanded ? 'route-panel--expanded' : ''}}">
    <button class="route-summary" bindtap="toggleRouteDetails">
      <view class="route-summary__identity">
        <text class="route-summary__label">线路</text>
        <text class="route-summary__name">{{routeName}}</text>
      </view>
      <text class="route-summary__action">{{routeDetailsExpanded ? '收起' : '查看线路'}}</text>
    </button>
    <view wx:if="{{routeDetailsExpanded}}" class="route-details">
      <view wx:if="{{routeDataErrorText}}" class="route-details__error">
        <text>{{routeDataErrorText}}</text>
      </view>
      <block wx:else>
      <scroll-view class="route-selector" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="route-selector__track">
          <button
            wx:for="{{routeOptions}}"
            wx:key="id"
            class="route-selector__button {{item.selected ? 'route-selector__button--active' : ''}}"
            size="mini"
            data-route-id="{{item.id}}"
            bindtap="handleRouteChange"
          >{{item.name}}</button>
        </view>
      </scroll-view>
      <view class="route-details__direction">
        <text class="route-details__label">方向</text>
        <view class="direction-switch">
          <button
            wx:for="{{routeDirections}}"
            wx:key="name"
            class="direction-switch__button {{item.selected ? 'direction-switch__button--active' : ''}}"
            size="mini"
            data-direction-name="{{item.name}}"
            bindtap="handleDirectionChange"
          >{{item.name}}</button>
        </view>
      </view>
      <text class="route-details__label route-details__stops-label">站点</text>
      <scroll-view class="route-stops" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="route-stops__track">
          <block wx:for="{{routeStops}}" wx:key="key">
            <view class="route-stop">
              <view class="route-stop__rail">
                <view class="route-stop__dot {{item.hasVerifiedCoordinate ? '' : 'route-stop__dot--pending'}}"></view>
                <view wx:if="{{!item.isLast}}" class="route-stop__line"></view>
              </view>
              <text class="route-stop__name">{{item.name}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
      <text class="route-panel__note">{{routeCoordinateStatusText}}</text>
      </block>
    </view>
  </view>
</view>
