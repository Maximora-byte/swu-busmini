.recovery { min-height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32rpx; padding: 48rpx; box-sizing: border-box; text-align: center; }
.recovery-title { font-size: 36rpx; font-weight: 600; }
.recovery-message, .recovery-error { font-size: 28rpx; line-height: 1.6; color: #315e49; }
.recovery button { color: #fff; background: #126b47; font-size: 30rpx; }
