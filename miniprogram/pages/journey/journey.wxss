page { background: #f1f5f3; overflow: hidden; }
button::after { border: 0; }
.glass-stage { position: relative; width: 100%; overflow: hidden; color: #243c32; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.journey-map { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
/* Floating controls carry the glass. The pale base remains readable over a native map without blur. */
.glass-surface {
  background: rgba(250,252,251,.97);
  background: linear-gradient(155deg,rgba(255,255,255,.99),rgba(245,249,247,.97));
  border: 1px solid rgba(255,255,255,.96);
  box-shadow: 0 2px 5px rgba(26,44,36,.05), 0 10px 26px rgba(26,44,36,.11), inset 0 1px 0 #fff, inset 0 -1px 0 rgba(209,220,214,.5);
}
@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass-surface { background: linear-gradient(155deg,rgba(255,255,255,.94),rgba(246,250,248,.91)); -webkit-backdrop-filter: blur(16px) saturate(1.12); backdrop-filter: blur(16px) saturate(1.12); }
}
.icon { width: 22px; height: 22px; display: block; }
.small-icon { width: 18px; height: 18px; display: block; }
.tiny-icon { width: 15px; height: 15px; display: block; flex: none; }
