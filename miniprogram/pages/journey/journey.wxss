.form-tools { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; color: #58675f; font-size: 20rpx; } .swap-button { margin: 0; padding: 4px 5px; display: inline-flex; align-items: center; gap: 4px; color: #456f51; background: transparent; font-size: 21rpx; line-height: 1.5; }
