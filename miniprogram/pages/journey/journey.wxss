.journey-page { display: flex; flex-direction: column; height: 100%; overflow: hidden; background: #f4f7f5; }
.journey-header { display: flex; flex: none; justify-content: space-between; align-items: center; padding: 18rpx 26rpx 6rpx; background: #fff; }
.journey-title { color: #173f30; font-size: 34rpx; font-weight: 700; }
.notes-button { flex: none; margin: 0; color: #5c7066; background: #edf3ee; font-size: 22rpx; }
.home-tabs { flex: none; display: flex; gap: 12rpx; padding: 10rpx 24rpx; background: #fff; }
.home-tab { flex: 1; margin: 0; border-radius: 10rpx; color: #627468; background: #edf3ee; font-size: 26rpx; line-height: 2.1; }
.home-tab--active { color: #fff; background: #126b47; font-weight: 600; }
.source-note { flex: none; display: block; padding: 4rpx 26rpx 14rpx; background: #fff; font-size: 21rpx; color: #65786d; }
.line-selector { flex: none; width: 100%; height: 76rpx; white-space: nowrap; background: #fff; }
.line-selector__track { display: inline-flex; gap: 12rpx; padding: 8rpx 24rpx; }
.line-button { flex: none; margin: 0; border: 2rpx solid; border-radius: 12rpx; font-size: 24rpx; color: #315e49; background: #edf4ee; }
.line-button--active { color: #fff; background: #126b47; font-weight: 600; }
.map-heading { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 8rpx 26rpx; background: #e8f1e9; }
.map-title { font-size: 23rpx; color: #315e49; }
.map-fit { margin: 0 0 0 10rpx; line-height: 40rpx; font-size: 21rpx; color: #315e49; background: #fff; }
.campus-toolbar { flex: none; display: flex; align-items: center; gap: 10rpx; padding: 6rpx 24rpx 12rpx; background: #fff; }
.campus-toolbar button { flex: 1; min-width: 0; margin: 0; padding: 0 8rpx; font-size: 22rpx; line-height: 2.2; color: #315e49; background: #edf4ee; }
.network-toggle { display: flex; align-items: center; flex: none; font-size: 21rpx; color: #315e49; }
.network-toggle switch { transform: scale(.65); width: 70rpx; margin-left: -10rpx; transform-origin: left center; }
.map-location-message { flex: none; padding: 8rpx 24rpx; color: #647568; font-size: 22rpx; }
.map-legend { flex: none; height: 48rpx; width: 100%; background: #fff; white-space: nowrap; }
.map-legend__track { display: inline-flex; align-items: center; gap: 26rpx; padding: 6rpx 24rpx; }
.map-legend__item { display: inline-flex; align-items: center; gap: 10rpx; color: #315e49; font-size: 22rpx; }
.map-legend__line { width: 40rpx; height: 7rpx; border-radius: 6rpx; }
.basemap-note { flex: none; padding: 2rpx 24rpx 7rpx; color: #7c897e; background: #fff; font-size: 19rpx; line-height: 1.4; }
.campus-panel { flex: none; padding: 10rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); background: #fff; }
.route-summary { width: 100%; margin: 0; padding: 12rpx 16rpx; background: #edf4ee; border-radius: 12rpx; line-height: 1.5; text-align: left; }
.route-summary__heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #42684f; font-size: 23rpx; }
.route-badge { padding: 4rpx 14rpx; border-radius: 7rpx; color: #fff; font-size: 25rpx; }
.route-summary__path { display: block; margin-top: 8rpx; color: #617668; font-size: 23rpx; }
.reference-orders { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 0; }
.reference-orders button { flex: none; margin: 0; padding: 0 14rpx; color: #42684f; background: #f0f4ef; font-size: 21rpx; }
.reference-orders .reference-order--active { color: #fff; background: #126b47; }
.reference-orders text { flex: 1; color: #8b7855; font-size: 19rpx; line-height: 1.4; }
.campus-stops { height: 260rpx; width: 100%; }
.campus-stop { padding: 12rpx 10rpx; border-bottom: 1rpx solid #e2e9e1; border-radius: 8rpx; }
.campus-stop--selected { background: #edf5ec; }
.campus-stop__main { display: flex; align-items: center; gap: 14rpx; }
.campus-stop__number { width: 36rpx; font-size: 26rpx; text-align: center; font-weight: 700; }
.campus-stop__name { flex: 1; color: #244c36; font-size: 25rpx; }
.campus-stop__status { display: block; margin-top: 4rpx; color: #8a825e; font-size: 19rpx; }
.campus-stop__actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 10rpx; }
.campus-stop__actions button { margin: 0; color: #315e49; background: #edf4ee; font-size: 20rpx; line-height: 2; }
.campus-stop__actions button[disabled] { color: #9a9f96; background: #f1f2ef; }
.review-status { flex: none; padding: 8rpx 26rpx; color: #876229; background: #fff8e8; font-size: 20rpx; line-height: 1.5; }
.review-status text { display: block; }
.map-selection { flex: none; display: flex; align-items: center; gap: 12rpx; padding: 10rpx 24rpx; color: #205394; background: #eaf2ff; font-size: 23rpx; line-height: 1.5; }
.map-selection text { flex: 1; }
.map-selection button { flex: none; margin: 0; font-size: 22rpx; color: #205394; background: #fff; }
.reference-legend { flex: none; display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; padding: 8rpx 24rpx; color: #647568; background: #fff; font-size: 20rpx; }
.reference-origin { color: #2869d8; }
.reference-destination { color: #854cc5; }
.journey-map { flex: 1; width: 100%; min-height: 200rpx; height: 0; }
.stop-message { flex: none; padding: 8rpx 24rpx; font-size: 23rpx; color: #315e49; background: #e8f1e9; }
.journey-content { flex: 1; height: 0; min-height: 260rpx; }
.journey-content__inner { padding: 22rpx 24rpx calc(30rpx + env(safe-area-inset-bottom)); }
.data-notes-panel { flex: none; width: 100%; height: 200rpx; background: #eef2e9; }
.data-notes-panel .data-notes { margin: 0; padding: 14rpx 24rpx; }
.journey-form { padding: 20rpx; background: #fff; border-radius: 18rpx; }
.field-heading { display: flex; justify-content: space-between; align-items: center; margin: 8rpx 0 12rpx; color: #4b6758; font-size: 25rpx; }
.location-button { flex: none; margin: 0 0 0 12rpx; font-size: 22rpx; color: #126b47; background: #edf5ee; }
.place-input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 16rpx 20rpx; font-size: 27rpx; color: #244333; background: #f0f5f1; border: 2rpx solid #dbe8df; border-radius: 12rpx; }
.endpoint-mode { display: block; margin: 12rpx 2rpx; color: #637968; font-size: 22rpx; line-height: 1.5; }
.endpoint-actions { display: flex; align-items: stretch; gap: 16rpx; }
.endpoint-actions button, .exact-picker { flex: 1; min-width: 0; }
.endpoint-actions button { margin: 0; font-size: 23rpx; color: #245e45; background: #eaf3ec; }
.exact-picker__button { padding: 8rpx; border-radius: 8rpx; color: #627468; background: #f1f3ee; font-size: 23rpx; line-height: 1.8; text-align: center; }
.destination-heading { margin-top: 26rpx; }
.search-panel { margin: 8rpx 0 14rpx; padding: 10rpx; background: #f7faf6; border: 1rpx solid #d6e4d7; border-radius: 10rpx; }
.search-hint { display: block; margin: 12rpx 2rpx; color: #6a7c6e; font-size: 21rpx; line-height: 1.6; }
.search-results { width: 100%; }
.search-result { display: block; margin: 0; min-height: 88rpx; padding: 20rpx 12rpx; color: #24573e; background: #fff; border-bottom: 1rpx solid #e5ece5; border-radius: 0; font-size: 23rpx; line-height: 1.7; text-align: left; white-space: normal; }
.location-message { display: block; margin: 12rpx 0; font-size: 23rpx; line-height: 1.5; color: #826523; }
.plan-button { margin-top: 24rpx; font-size: 28rpx; color: #fff; background: #126b47; border-radius: 12rpx; }
.journey-message { display: block; margin: 22rpx 4rpx; color: #596f61; font-size: 25rpx; line-height: 1.6; }
.journey-card { margin-bottom: 22rpx; padding: 22rpx; background: #fff; border: 2rpx solid #dde7df; border-radius: 18rpx; }
.journey-card--selected { border-color: #126b47; }
.journey-card__heading { display: flex; flex-direction: column; gap: 8rpx; color: #174231; font-size: 30rpx; font-weight: 700; }
.journey-card__distance { color: #738175; font-size: 22rpx; font-weight: 400; }
.recommendation-badge { display: inline-block; margin-right: 12rpx; padding: 3rpx 12rpx; border-radius: 8rpx; color: #fff; background: #126b47; font-size: 23rpx; font-weight: 500; }
.journey-connection { display: block; margin-top: 12rpx; color: #3b6751; font-size: 22rpx; line-height: 1.6; }
.recommendation-reason { display: block; margin-top: 8rpx; color: #738175; font-size: 21rpx; line-height: 1.6; }
.ride-leg { padding-top: 20rpx; }
.ride-leg + .ride-leg { margin-top: 16rpx; border-top: 1rpx dashed #c4d4c9; }
.ride-leg__line { display: block; margin-bottom: 10rpx; padding-left: 12rpx; border-left: 6rpx solid; color: #174231; font-size: 27rpx; font-weight: 600; }
.ride-leg__station { display: block; color: #304c3d; font-size: 25rpx; line-height: 1.6; }
.ride-leg__path { display: block; margin: 14rpx 0; padding: 16rpx; color: #597161; background: #f1f6f1; border-radius: 10rpx; font-size: 23rpx; line-height: 1.7; }
.point-actions { display: flex; gap: 16rpx; }
.point-actions button { flex: 1; margin: 0; font-size: 23rpx; color: #315e49; background: #edf5ee; }
.show-journey { margin: 20rpx 0 0; font-size: 25rpx; color: #126b47; background: #edf5ee; }
.data-notes { margin: 24rpx 0 8rpx; padding: 20rpx; color: #778176; background: #eef2e9; border-radius: 14rpx; font-size: 22rpx; line-height: 1.7; }
.data-notes text { display: block; margin-bottom: 10rpx; }
.data-warning { display: block; margin-top: 10rpx; color: #956324; font-size: 22rpx; line-height: 1.6; }
button::after { border: none; }
