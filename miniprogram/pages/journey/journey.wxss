.tool-icon { width: 20px; height: 20px; display: block; }
/* The large moving content sheet is deliberately high opacity and never filters the map. */
.glass-sheet { position: absolute; top: 0; left: 12px; right: 12px; z-index: 20; overflow: hidden; box-sizing: border-box; border-radius: 27px; border: 1px solid rgba(255,255,255,.96); background: linear-gradient(155deg,rgba(255,255,255,.99),rgba(247,250,248,.98)); box-shadow: 0 3px 8px rgba(24,42,33,.06), 0 18px 46px rgba(24,42,33,.16), inset 0 1px 0 #fff; will-change: transform; transition: transform 260ms cubic-bezier(.22,1,.36,1); }
.glass-sheet::before { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1; border-radius: 26px; box-shadow: inset 1px 1px 0 rgba(255,255,255,.96), inset -1px -1px 0 rgba(208,222,213,.45); }
.sheet-header { position: relative; height: 60px; box-sizing: border-box; padding: 7px 12px 7px; background: linear-gradient(180deg,rgba(255,255,255,.94),rgba(255,255,255,.32)); touch-action: none; }
