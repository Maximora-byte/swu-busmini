page { background: #eef5f0; overflow: hidden; }
button::after { border: 0; }
.glass-stage { position: relative; width: 100%; overflow: hidden; color: #203e33; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.journey-map { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
.glass-surface { background: rgba(255,255,255,.97); border: 1px solid rgba(255,255,255,.9); box-shadow: 0 6px 22px rgba(33,64,48,.1), inset 0 1px 0 rgba(255,255,255,.94); }
@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass-surface { background: rgba(250,255,252,.85); -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2); }
}
.icon { width: 22px; height: 22px; display: block; }
.small-icon { width: 18px; height: 18px; display: block; }
.tiny-icon { width: 15px; height: 15px; display: block; flex: none; }
.button-press { opacity: .86; transform: scale(.975); }
.floating-search { position: absolute; left: 14px; right: 14px; top: 12px; z-index: 30; height: 52px; margin: 0; padding: 8px 12px; box-sizing: border-box; display: flex; align-items: center; gap: 10px; border-radius: 22px; text-align: left; line-height: 1.2; color: #203e33; }
.search-symbol { width: 32px; height: 32px; border-radius: 13px; background: #e5f3eb; display: flex; align-items: center; justify-content: center; flex: none; }
.search-copy { flex: 1; min-width: 0; }
.search-title { display: block; font-size: 30rpx; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.search-subtitle { display: block; margin-top: 3px; color: #73877a; font-size: 20rpx; }
.search-route-cue { display: flex; align-items: center; gap: 4px; flex: none; padding: 8px 9px; border-radius: 14px; background: rgba(225,241,231,.9); color: #20583e; font-size: 24rpx; font-weight: 600; }
.floating-route-legend { position: absolute; top: 76px; left: 14px; width: calc(100% - 28px); height: 29px; z-index: 8; border-radius: 15px; box-sizing: border-box; white-space: nowrap; }
.legend-track { display: inline-flex; gap: 14px; align-items: center; padding: 5px 12px; }
.legend-item { display: inline-flex; align-items: center; gap: 6px; font-size: 21rpx; color: #315546; }
.legend-line { width: 22px; height: 4px; border-radius: 4px; }
.legend-caption { color: #7b8c80; font-size: 19rpx; }
.map-selection { position: absolute; top: 76px; left: 14px; right: 14px; z-index: 16; display: flex; align-items: center; gap: 8px; border-radius: 18px; padding: 5px 5px 5px 12px; color: #265747; font-size: 24rpx; line-height: 1.5; }
.map-selection text { flex: 1; }
.icon-button { margin: 0; width: 38px; height: 38px; padding: 8px; display: flex; align-items: center; justify-content: center; background: transparent; border-radius: 14px; }
.map-tools { position: absolute; right: 14px; top: 0; z-index: 10; width: 46px; display: flex; flex-direction: column; gap: 8px; transition: transform 260ms cubic-bezier(.22,1,.36,1), opacity 180ms ease; }
.map-tools--hidden { pointer-events: none; }
.map-tool { margin: 0; padding: 5px 0; width: 46px; height: 44px; box-sizing: border-box; border-radius: 17px; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 1px; color: #315546; font-size: 18rpx; line-height: 1.2; }
.map-tool--active { background: #e4f6eb; border-color: #a9d9bc; }
.map-tool[disabled] { color: #84958a; }
.tool-icon { width: 20px; height: 20px; display: block; }
.glass-sheet { position: absolute; top: 0; left: 12px; right: 12px; z-index: 20; overflow: hidden; box-sizing: border-box; border-radius: 27px; border: 1px solid rgba(255,255,255,.95); background: linear-gradient(145deg,rgba(255,255,255,.98),rgba(242,249,245,.95)); box-shadow: 0 12px 40px rgba(30,66,47,.17), inset 0 1px 1px rgba(255,255,255,1); will-change: transform; transition: transform 260ms cubic-bezier(.22,1,.36,1); }
.glass-sheet::before { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1; border-radius: 26px; box-shadow: inset 1px 1px 0 rgba(255,255,255,.92), inset -1px -1px 0 rgba(218,235,224,.45); }
.sheet-header { position: relative; height: 60px; box-sizing: border-box; padding: 7px 12px 7px; background: linear-gradient(180deg,rgba(255,255,255,.9),rgba(255,255,255,.25)); touch-action: none; }
.sheet-grip { width: 33px; height: 4px; margin: 0 auto 5px; border-radius: 6px; background: #c9d6cc; }
.sheet-heading { height: 37px; display: flex; align-items: center; gap: 4px; }
.sheet-heading-copy { flex: 1; min-width: 0; padding-left: 3px; }
.sheet-title { display: block; color: #244536; font-size: 29rpx; font-weight: 700; letter-spacing: .3px; }
.sheet-subtitle { display: block; margin-top: 3px; color: #819185; font-size: 19rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.header-icon-button { width: 30px; height: 34px; flex: none; margin: 0; padding: 6px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: transparent; }
.tiny-text-button { flex: none; margin: 0 3px 0 0; padding: 6px 9px; border-radius: 12px; color: #28704f; background: #eaf4ee; font-size: 22rpx; line-height: 1.4; }
.chevron-up { transform: rotate(180deg); }
.sheet-scroll { position: relative; width: 100%; }
.sheet-content { padding: 9px 14px 18px; box-sizing: border-box; }
.browse-content { padding: 4px 11px 12px; }
.line-selector { width: 100%; height: 40px; white-space: nowrap; }
.line-track { display: inline-flex; align-items: center; gap: 7px; padding: 2px 0 4px; }
.line-button { flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 5px; margin: 0; padding: 0 10px; height: 32px; line-height: 1.3; border: 1px solid; border-radius: 13px; font-size: 22rpx; color: #335c48; }
.line-button--active { font-weight: 650; }
.route-dot { flex: none; width: 7px; height: 7px; border-radius: 50%; }
.route-summary { margin: 0; width: 100%; height: 60px; padding: 9px 11px; border-radius: 18px; border: 1px solid #e5eee7; background: rgba(234,244,236,.73); box-sizing: border-box; display: flex; align-items: center; gap: 8px; text-align: left; line-height: 1.4; }
.route-summary-copy { flex: 1; min-width: 0; }
.route-summary-title { display: flex; align-items: center; gap: 6px; color: #264d39; font-size: 25rpx; font-weight: 650; }
.route-count { margin-left: auto; color: #869489; font-size: 19rpx; font-weight: 400; }
.route-summary-path { display: block; margin-top: 5px; color: #758779; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.route-detail-content { padding: 10px 0 0; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 8px 0; color: #315442; font-size: 26rpx; font-weight: 650; }
.reference-orders { display: flex; align-items: center; gap: 3px; padding: 3px; border-radius: 12px; background: #eaf1eb; }
.order-button { padding: 5px 10px; margin: 0; color: #7a8a7d; background: transparent; border-radius: 9px; font-size: 21rpx; line-height: 1.3; }
.order-button--active { color: #286747; background: #fff; box-shadow: 0 2px 6px rgba(43,76,52,.07); }
.quiet-note { display: block; margin: 8px 0; color: #839185; font-size: 20rpx; line-height: 1.6; font-weight: 400; }
.campus-stop { padding: 13px 3px 10px; border-bottom: 1px solid #e6eee7; }
.campus-stop--selected { background: #edf7ef; border-radius: 14px; }
.campus-stop-main { display: flex; align-items: stretch; gap: 9px; }
.stop-rail { position: relative; flex: none; width: 24px; display: flex; justify-content: center; }
.stop-number { position: relative; z-index: 1; width: 23px; height: 23px; display: flex; align-items: center; justify-content: center; border: 1px solid #d2e4d7; border-radius: 9px; color: #478064; background: #f2faf4; font-size: 21rpx; font-weight: 600; }
.stop-rail-line { position: absolute; left: 11px; top: 24px; bottom: -45px; width: 1px; background: #dce9df; }
.stop-copy { flex: 1; min-width: 0; }
.stop-name { display: block; color: #365845; font-size: 26rpx; }
.stop-caption { display: block; margin-top: 4px; color: #94a093; font-size: 19rpx; line-height: 1.5; }
.stop-caption--review { color: #a47a43; }
.stop-actions { display: flex; justify-content: flex-end; gap: 8px; margin: 9px 0 0 32px; }
.subtle-button { display: inline-flex; align-items: center; justify-content: center; gap: 5px; min-height: 32px; margin: 0; padding: 7px 12px; border-radius: 12px; color: #407157; background: rgba(231,242,234,.9); font-size: 22rpx; line-height: 1.3; }
.subtle-button[disabled] { color: #a1aa9f; background: #f0f3ef; }
.overview-actions { display: flex; gap: 10px; padding-top: 14px; }
.compact-journey, .compact-empty { padding-top: 5px; }
.compact-endpoints { display: flex; align-items: center; justify-content: center; gap: 8px; color: #365845; font-size: 27rpx; font-weight: 600; }
.compact-endpoints text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.compact-meta { display: flex; justify-content: space-between; margin: 6px 1px 8px; color: #8a988b; font-size: 20rpx; }
.compact-actions { display: flex; gap: 9px; }
.compact-actions .subtle-button { flex: 1; }
.compact-primary { flex: 1; margin: 0; min-height: 32px; padding: 7px 13px; border-radius: 12px; background: #15815b; color: #fff; font-size: 23rpx; display: flex; align-items: center; justify-content: center; gap: 6px; line-height: 1.3; }
.compact-primary .tiny-icon { opacity: .8; filter: brightness(0) invert(1); }
.full-width { width: 100%; box-sizing: border-box; }
.planner-content { padding-top: 4px; }
.endpoint-field { margin-bottom: 15px; scroll-margin-top: 6px; }
.field-heading { display: flex; justify-content: space-between; align-items: center; height: 25px; margin-bottom: 6px; color: #7d8e80; font-size: 22rpx; }
.location-button { display: inline-flex; align-items: center; justify-content: center; gap: 3px; margin: 0; padding: 4px 7px; line-height: 1.3; font-size: 21rpx; color: #2b7b51; background: #e9f5ed; border-radius: 10px; }
.input-shell { display: flex; align-items: center; gap: 10px; padding: 0 10px; height: 46px; border: 1px solid #dde9df; border-radius: 16px; background: rgba(255,255,255,.84); box-shadow: inset 0 1px 4px rgba(73,112,83,.025); }
.endpoint-dot { width: 7px; height: 7px; border: 3px solid #d9f0e3; border-radius: 50%; flex: none; background: #24895e; }
.endpoint-dot--destination { background: #9771bf; border-color: #ece2f6; }
.place-input { flex: 1; min-width: 0; height: 44px; color: #335240; font-size: 27rpx; }
.input-clear { flex: none; width: 29px; height: 34px; padding: 7px; margin: 0; display: flex; align-items: center; justify-content: center; background: transparent; }
.endpoint-actions { display: flex; gap: 9px; margin-top: 8px; }
.endpoint-actions .subtle-button, .exact-picker { flex: 1; min-width: 0; }
.picker-button { min-height: 32px; box-sizing: border-box; padding: 7px 9px; display: flex; align-items: center; justify-content: center; gap: 5px; border-radius: 12px; border: 1px solid #e6ede7; background: #fff; color: #768d79; font-size: 22rpx; line-height: 1.3; }
.endpoint-mode, .location-message { display: block; margin: 6px 3px; color: #83947f; font-size: 20rpx; line-height: 1.5; }
.location-message { color: #9a7a4f; }
.search-panel { margin-top: 5px; border-radius: 14px; overflow: hidden; background: rgba(250,254,250,.8); }
.search-hint { display: block; padding: 6px 9px; color: #8b9a8a; font-size: 19rpx; line-height: 1.5; }
.search-result { width: 100%; margin: 0; padding: 11px 10px; min-height: 43px; color: #426c50; background: rgba(255,255,255,.92); border-bottom: 1px solid #ebf1e9; border-radius: 0; font-size: 24rpx; line-height: 1.6; text-align: left; }
.plan-button { width: 100%; margin: 3px 0 9px; padding: 13px 16px; display: flex; align-items: center; justify-content: center; gap: 10px; box-sizing: border-box; border-radius: 18px; color: #fff; background: linear-gradient(125deg,#18885f,#0c7051); box-shadow: 0 5px 13px rgba(26,127,84,.15); font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.plan-button[disabled] { color: #eff9f2; background: #8ebca4; box-shadow: none; }
.button-arrow { width: 20px; height: 20px; }
.plan-notice { display: block; margin: 3px 0 12px; padding: 11px 12px; border-radius: 14px; background: #fff6e8; color: #9b7a47; font-size: 23rpx; line-height: 1.6; }
.journey-results { padding-top: 8px; }
.journey-card { margin: 9px 0 14px; padding: 14px; border: 1px solid #e1ebe3; border-radius: 21px; background: rgba(255,255,255,.9); }
.journey-card--selected { border-color: #9bcbb0; box-shadow: 0 4px 15px rgba(58,114,72,.06); }
.journey-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 28rpx; color: #345741; font-weight: 650; }
.recommendation-badge { display: inline-block; margin-right: 7px; padding: 3px 7px; border-radius: 7px; color: #218359; background: #e3f5e9; font-size: 19rpx; vertical-align: 2px; }
.journey-distance { color: #93a08f; font-size: 19rpx; font-weight: 400; }
.journey-connection { display: block; margin: 8px 0 11px; color: #7c927e; font-size: 21rpx; line-height: 1.6; }
.ride-leg { margin-top: 12px; }
.ride-line { display: flex; align-items: center; gap: 6px; color: #426b4e; font-size: 25rpx; font-weight: 600; }
.ride-direction { margin-left: auto; color: #97a38f; font-size: 19rpx; font-weight: 400; }
.ride-stations { display: block; margin: 8px 0; color: #537257; font-size: 24rpx; line-height: 1.6; }
.ride-path { display: block; padding: 9px 10px; border-radius: 12px; background: #f1f7ef; color: #8b9b82; font-size: 20rpx; line-height: 1.8; }
.point-actions { display: flex; gap: 8px; margin-top: 8px; }
.point-actions .subtle-button { flex: 1; min-width: 0; font-size: 21rpx; }
.show-journey { width: 100%; margin: 12px 0 0; padding: 9px 12px; display: flex; align-items: center; justify-content: center; gap: 6px; color: #4b7c58; background: #ecf6ec; border-radius: 13px; font-size: 23rpx; line-height: 1.5; }
.data-notes { color: #81907d; font-size: 24rpx; line-height: 1.8; }
.data-notes text { display: block; margin-bottom: 14px; }
.section-eyebrow { color: #3b6f4c; font-size: 27rpx; font-weight: 650; }
.data-warning { padding: 10px 12px; border-radius: 13px; background: #fff6e8; color: #a07a46; }
@media (prefers-reduced-motion: reduce) { .glass-sheet, .map-tools { transition: none !important; } .button-press { transform: none; } }
.form-tools { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; color: #94a18f; font-size: 20rpx; } .swap-button { margin: 0; padding: 4px 5px; display: inline-flex; align-items: center; gap: 4px; color: #5d8464; background: transparent; font-size: 21rpx; line-height: 1.5; }
.header-route-legend { display: flex; align-items: center; gap: 10px; margin-top: 4px; overflow: hidden; height: 13px; } .header-route-legend .legend-item { font-size: 19rpx; white-space: nowrap; } .header-route-legend .legend-line { width: 15px; height: 3px; } .compact-actions { margin-top: 8px; }
.subtle-button, .compact-primary { box-sizing: border-box; } .glass-stage--compact .sheet-content { padding-bottom: 9px; } .glass-stage--compact .compact-empty .quiet-note { display: none; }
