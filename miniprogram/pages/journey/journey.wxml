<view class="journey-page {{viewMode === 'map' ? 'journey-page--map' : ''}}">
  <view class="journey-header">
    <text class="journey-title">SWU Go · 校园出行</text>
    <button class="notes-button" size="mini" bindtap="toggleDataNotes">{{dataNotesExpanded ? '收起说明' : '数据说明'}}</button>
  </view>
  <view class="home-tabs"><button class="home-tab {{viewMode === 'map' ? 'home-tab--active' : ''}}" data-view="map" bindtap="handleViewChange">校园地图</button><button class="home-tab {{viewMode === 'journey' ? 'home-tab--active' : ''}}" data-view="journey" bindtap="handleViewChange">出行规划</button></view>
  <text class="source-note">{{sourceText}} · 静态数据</text>
  <scroll-view wx:if="{{viewMode === 'map'}}" class="line-selector" scroll-x>
    <view class="line-selector__track">
      <button wx:for="{{routeOptions}}" wx:key="id" class="line-button" style="border-color: {{item.color}}; background: {{selectedRouteId === item.id ? item.color : '#ffffff'}}; color: {{selectedRouteId === item.id ? '#ffffff' : '#315e49'}}" size="mini" data-route-id="{{item.id}}" bindtap="handleRouteChange">{{item.name}}</button>
    </view>
  </scroll-view>
  <view wx:if="{{viewMode === 'map'}}" class="campus-toolbar"><button size="mini" bindtap="handleCampusOverview">校园全览</button><button size="mini" bindtap="handleBeibeiOverview">北碚城区</button><button size="mini" loading="{{mapLocating}}" disabled="{{mapLocating}}" bindtap="handleMapLocate">我的位置</button><label class="network-toggle"><switch checked="{{showAllRoutes}}" color="#126b47" bindchange="handleNetworkChange" />全线路</label></view>
  <text wx:if="{{viewMode === 'map' && mapLocationMessage}}" class="map-location-message">{{mapLocationMessage}}</text>
  <view class="map-heading"><text class="map-title">{{mapTitle}}</text><button size="mini" class="map-fit" bindtap="fitMap">看全图</button></view>
  <view class="review-status"><text>{{directionStatusText}}</text></view>
  <view wx:if="{{mapSelectionField}}" class="map-selection"><text>{{mapSelectionMessage}}</text><button size="mini" bindtap="handleCancelMapSelection">取消选点</button></view>
  <map id="journey-map" class="journey-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" min-scale="{{minScale}}" max-scale="{{maxScale}}" markers="{{mapMarkers}}" polyline="{{mapPolylines}}" circles="{{mapCircles}}" bindtap="handleMapTap" bindmarkertap="handleMarkerTap" bindcallouttap="handleMarkerTap" show-location="{{originMode === 'coordinate' || !!mapLocation}}" show-scale></map>
  <scroll-view class="map-legend" scroll-x><view class="map-legend__track"><view wx:for="{{mapLegend}}" wx:key="routeId" class="map-legend__item"><view class="map-legend__line" style="background: {{item.color}}"></view><text>{{item.name}}</text></view></view></scroll-view>
  <text class="basemap-note">校车轨迹以图例实线为准，底图其他线条不表示校车路线。</text>
  <view wx:if="{{mapCircles.length}}" class="reference-legend"><text wx:if="{{originCoordinate}}" class="reference-origin">● 出发参考位置</text><text wx:if="{{destinationCoordinate}}" class="reference-destination">● 到达参考位置</text><text>图标为实际乘降点</text></view>
  <text wx:if="{{stopMessage}}" class="stop-message">{{stopMessage}}</text>
  <scroll-view wx:if="{{dataNotesExpanded}}" class="data-notes-panel" scroll-y><view class="data-notes">
    <text>非官方校园出行参考。线路与坐标为运营方发布资料，未冒称现场测量；实际停靠和运营方向请结合现场核对。</text>
    <text>6／7／8的近闭环不证明连续循环运营，当前不补闭合边。偏移待核对点保留原位置，暂停该线路的自动乘降，不代表停站。</text>
    <text>接驳为直线估计，未绘制步行道路；当前不提供实时车辆、等待或到站预测。</text>
    <text wx:for="{{routeWarnings}}" wx:key="*this" class="data-warning">{{item}}</text>
  </view></scroll-view>
  <view wx:if="{{viewMode === 'map'}}" class="campus-panel">
    <button class="route-summary" bindtap="toggleRouteDetails"><view class="route-summary__heading"><text class="route-badge" style="background: {{routeColor}}">{{routeName}}</text><text>{{routeDetailsExpanded ? '收起站序 ↑' : '展开站序 ↓'}}</text></view><text class="route-summary__path">{{routeSummary}}</text></button>
    <view wx:if="{{routeDetailsExpanded}}" class="reference-orders"><button size="mini" class="{{!referenceReverse ? 'reference-order--active' : ''}}" data-order="forward" bindtap="handleReferenceOrderChange">正序参考</button><button size="mini" class="{{referenceReverse ? 'reference-order--active' : ''}}" data-order="reverse" bindtap="handleReferenceOrderChange">反序参考</button><text>几何参考顺序，非运营方向</text></view>
    <scroll-view wx:if="{{routeDetailsExpanded}}" class="campus-stops" scroll-y>
      <view wx:for="{{routeStops}}" wx:key="key" class="campus-stop {{selectedVisitKey === item.key ? 'campus-stop--selected' : ''}}">
        <view class="campus-stop__main" data-visit-key="{{item.key}}" bindtap="handleRouteStopTap"><text class="campus-stop__number" style="color: {{routeColor}}">{{index + 1}}</text><view class="campus-stop__name"><text>{{item.name}}</text><text class="campus-stop__status">{{item.canBoard ? '查看候车参考位置' : item.reviewText}}</text></view></view>
        <view class="campus-stop__actions"><button size="mini" disabled="{{!item.canBoard}}" data-visit-key="{{item.key}}" data-field="origin" bindtap="handleUseRouteStop">从此出发</button><button size="mini" disabled="{{!item.canBoard}}" data-visit-key="{{item.key}}" data-field="destination" bindtap="handleUseRouteStop">到这里</button></view>
      </view>
    </scroll-view>
  </view>
  <scroll-view wx:if="{{viewMode === 'journey'}}" class="journey-content" scroll-y>
    <view class="journey-content__inner">
      <view class="journey-form">
        <view class="field-heading"><text>从哪里出发</text><button size="mini" class="location-button" loading="{{locating}}" disabled="{{locating}}" bindtap="handleUseLocation">从我的位置出发</button></view>
        <input class="place-input" value="{{originQuery}}" maxlength="64" placeholder="搜站名、简称，如中图、五号门" confirm-type="search" data-field="origin" bindinput="handleSearchInput" bindfocus="handleSearchFocus" bindconfirm="handlePlanJourney" />
        <view wx:if="{{activeSearchField === 'origin'}}" class="search-panel">
          <text class="search-hint">{{searchMessage}}</text>
          <scroll-view wx:if="{{searchResults.length}}" class="search-results" scroll-y style="height: {{searchResults.length > 3 ? 264 : searchResults.length * 88}}rpx">
            <button wx:for="{{searchResults}}" wx:key="stopId" class="search-result" data-field="origin" data-stop-id="{{item.stopId}}" data-search-version="{{searchVersion}}" bindtap="handleSelectSearchResult">{{item.label}}</button>
          </scroll-view>
        </view>
        <text class="endpoint-mode">{{originMode === 'stop' ? '指定上车站：' + stopNames[originIndex] : originMode === 'search' ? '请确认出发位置' : '自动比较附近上车点'}}</text>
        <view class="endpoint-actions"><button size="mini" data-field="origin" bindtap="handleStartMapSelection">地图选起点</button><picker class="exact-picker" range="{{stopNames}}" value="{{originIndex}}" disabled="{{!stopNames.length}}" bindchange="handleOriginChange"><view class="exact-picker__button">指定上车站 ⌄</view></picker></view>
        <text wx:if="{{locationMessage}}" class="location-message">{{locationMessage}}</text>
        <text class="field-heading destination-heading">到哪里去</text>
        <input class="place-input" value="{{destinationQuery}}" maxlength="64" placeholder="输入目的地，自动推荐下车点" confirm-type="search" data-field="destination" bindinput="handleSearchInput" bindfocus="handleSearchFocus" bindconfirm="handlePlanJourney" />
        <view wx:if="{{activeSearchField === 'destination'}}" class="search-panel">
          <text class="search-hint">{{searchMessage}}</text>
          <scroll-view wx:if="{{searchResults.length}}" class="search-results" scroll-y style="height: {{searchResults.length > 3 ? 264 : searchResults.length * 88}}rpx">
            <button wx:for="{{searchResults}}" wx:key="stopId" class="search-result" data-field="destination" data-stop-id="{{item.stopId}}" data-search-version="{{searchVersion}}" bindtap="handleSelectSearchResult">{{item.label}}</button>
          </scroll-view>
        </view>
        <text class="endpoint-mode">{{destinationMode === 'stop' ? '指定下车站：' + stopNames[destinationIndex] : destinationMode === 'search' ? '请确认到达位置' : '自动比较附近下车点'}}</text>
        <view class="endpoint-actions"><button size="mini" data-field="destination" bindtap="handleStartMapSelection">地图选终点</button><picker class="exact-picker" range="{{stopNames}}" value="{{destinationIndex}}" disabled="{{!stopNames.length}}" bindchange="handleDestinationChange"><view class="exact-picker__button">指定下车站 ⌄</view></picker></view>
        <button class="plan-button" disabled="{{!stopNames.length}}" bindtap="handlePlanJourney">查询直达 / 一次换乘</button>
        <text class="search-hint">搜索结果是位置参考，推荐乘降点可能不同；起终点各比较800米内最多六站。</text>
      </view>
      <text class="journey-message">{{journeyMessage}}</text>
      <view wx:for="{{journeys}}" wx:key="id" wx:for-item="journey" class="journey-card {{selectedJourneyId === journey.id ? 'journey-card--selected' : ''}}">
        <view class="journey-card__heading"><view><text wx:if="{{journey.isRecommended}}" class="recommendation-badge">推荐</text><text>{{journey.title}}</text></view><text class="journey-card__distance">{{journey.distanceText}}</text></view>
        <text class="journey-connection">{{journey.connectionText}}</text>
        <text wx:if="{{journey.isRecommended}}" class="recommendation-reason">优先少换乘，再比较接驳直线距离和乘车里程。</text>
        <view wx:for="{{journey.legs}}" wx:key="routeId" wx:for-item="leg" wx:for-index="legIndex" class="ride-leg">
          <text class="ride-leg__line" style="border-left-color: {{leg.color}}">{{leg.routeName}} · {{leg.directionText}}</text>
          <text class="ride-leg__station">上车：{{leg.boardingName}}　→　下车：{{leg.alightingName}}</text>
          <text class="ride-leg__path">{{leg.pathText}}</text>
          <view class="point-actions">
            <button size="mini" data-journey-id="{{journey.id}}" data-leg-index="{{legIndex}}" data-point-kind="boarding" bindtap="handleOpenStop">查看上车点</button>
            <button size="mini" data-journey-id="{{journey.id}}" data-leg-index="{{legIndex}}" data-point-kind="alighting" bindtap="handleOpenStop">查看下车点</button>
          </view>
        </view>
        <button class="show-journey" data-journey-id="{{journey.id}}" bindtap="handleShowJourney">{{selectedJourneyId === journey.id ? '地图正在显示此方案' : '在地图查看乘车区间'}}</button>
      </view>
    </view>
  </scroll-view>
</view>
