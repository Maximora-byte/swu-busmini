{
  "name": "swu-busmini",
  "version": "0.1.0",
  "private": true,
  "description": "SWU Go - \u897f\u5357\u5927\u5b66\u5317\u789a\u6821\u533a\u975e\u5b98\u65b9\u6821\u56ed\u6821\u8f66\u5bfc\u822a\u5fae\u4fe1\u5c0f\u7a0b\u5e8f",
  "scripts": {
    "sync:data": "tsx scripts/sync-data.ts",
    "check:data-sync": "tsx scripts/sync-data.ts --check",
    "geocode": "tsx scripts/geocode.ts",
    "generate:geometry": "tsx scripts/generate-route-geometry.ts",
    "generate:preview": "tsx scripts/generate-route-preview.ts",
    "review:coordinates": "tsx scripts/review-coordinates.ts",
    "review:geometry": "tsx scripts/review-route-geometry.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "validate:data": "tsx scripts/validate-routes.ts",
    "test:coverage": "c8 npm test"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "miniprogram-api-typings": "^4.0.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "c8": "12.0.0"
  },
  "c8": {
    "all": true,
    "include": [
      "miniprogram/**/*.ts",
      "scripts/**/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
